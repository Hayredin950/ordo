# Ordo server — copy to .env and fill in what you want to activate.
# Everything is optional; the app works without any of these (email+password only).

PORT=8787
DATABASE_URL=postgres://ordo:ordo_dev_pw@localhost:5434/ordo
APP_URL=http://localhost:5173
SESSION_DAYS=30

# --- Telegram bot (get a token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- OAuth (create an OAuth app at github.com/settings/developers and
#      console.cloud.google.com) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI coach (Anthropic API key; rule-based fallback when empty) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Slack (optional second channel) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Magic-link email (optional; without SMTP the code prints to the console) ---
SMTP_URL=
MAIL_FROM=Ordo <noreply@ordo.local>
