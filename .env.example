# Ordo — copy to .env.local for development, and set the same keys on Vercel.
# Nothing here is required to boot: without Supabase the app runs on local
# storage, and every integration below degrades to "not configured" in the UI.

# ---------------------------------------------------------------------------
# Supabase — this is the backend. Project Settings → API.
# The VITE_* pair is public by design; RLS is what protects the data.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security, so it is used by exactly two
# routes: the Telegram webhook and the cron tick. Never expose it to a client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# OAuth. Providers are configured in the Supabase dashboard (Authentication →
# Providers); these flags only tell the login page which buttons to show.
# ---------------------------------------------------------------------------
OAUTH_GITHUB=
OAUTH_GOOGLE=

# ---------------------------------------------------------------------------
# Scheduler. All three pingers send `Authorization: Bearer $CRON_SECRET` to
# /api/cron/tick. Vercel injects the header for its own cron automatically;
# GitHub Actions needs CRON_SECRET and ORDO_APP_URL as repository secrets.
# Generate one with: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# Minutes to shift the schedule from UTC, so "07:00" means 07:00 where you are.
# Example: 180 for UTC+3, -300 for UTC-5. Defaults to 0 (UTC).
ORDO_TZ_OFFSET_MINUTES=

# ---------------------------------------------------------------------------
# Telegram bot (@BotFather). Register the webhook once after deploying:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d "url=https://<your-app>/api/telegram/webhook" \
#     -d "secret_token=$TELEGRAM_WEBHOOK_SECRET"
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Slack (optional second channel). The bot must be invited to the channel.
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# AI coach. Without a key the weekly report falls back to a rule-based one.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---------------------------------------------------------------------------
# Only needed if the frontend and the API routes live on different origins.
# Empty means same-origin, which is the normal Vercel setup.
# ---------------------------------------------------------------------------
VITE_API_URL=
